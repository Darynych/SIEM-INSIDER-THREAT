# Copy to .env and edit, or export these before running.

# --- Elasticsearch (your SIEM server) ---
ES_URL=https://192.168.56.10:9200
ES_USER=elastic
ES_PASS=changeme
ES_INDEX=logs-*
ANOMALY_INDEX=ml-insider-anomalies
VERIFY_TLS=false          # lab uses a self-signed cert

# --- n8n SOAR webhook (leave blank until the workflow exists) ---
N8N_WEBHOOK_URL=
